{
  "name": "telegram-mcp",
  "version": "0.1.0",
  "description": "A deployable MCP server that gives an agent your real Telegram account",
  "scripts": {
    "test": "vitest run",
    "build": "tsc && node -e \"fs.cpSync('src/http/assets','dist/http/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
