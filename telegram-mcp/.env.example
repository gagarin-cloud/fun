# --- Telegram (userbot / MTProto credentials, NOT a bot token) -----------------
# Get these from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Server -------------------------------------------------------------------
# Encrypts everything this server hands out: OAuth client registrations,
# authorization codes, and the tokens that carry each user's Telegram session.
# Change it and every connector has to sign in again. Generate one:
#   openssl rand -hex 32
ENCRYPTION_KEY=

PORT=8080

# The address clients reach this server at. It is the OAuth issuer, so it has to
# be exact and stable — deploy.sh sets it from the deployed address; set it here
# only for local runs. Defaults to http://localhost:$PORT.
PUBLIC_URL=

# --- Connected accounts -------------------------------------------------------
# How long a signed-in account stays connected between calls, how many may be
# connected at once, and how long a half-finished sign-in waits for its code.
ACCOUNT_IDLE_MINUTES=15
MAX_ACCOUNTS=25
MAX_PENDING_LOGINS=20
LOGIN_TIMEOUT_MINUTES=10

# How long the tokens clients hold stay good. The refresh token is long-lived
# because the real credential behind it is the Telegram session, which the
# account holder can revoke at any time from the Telegram app.
ACCESS_TOKEN_TTL_HOURS=24
REFRESH_TOKEN_TTL_DAYS=365

# --- Rate limiting (per connected account) ------------------------------------
# Token buckets, "<capacity>/<refill per minute>". Tuned to stay well under
# Telegram's server-side limits so accounts do not get flood-waited.
RATE_LIMIT_DEFAULT=20/60
RATE_LIMIT_SEND=10/20
RATE_LIMIT_JOIN=3/6
RATE_LIMIT_SEARCH=10/30
RATE_LIMIT_DOWNLOAD=5/20
# A FLOOD_WAIT shorter than this is slept through and retried; longer is
# reported to the caller as an error telling it when to come back.
MAX_FLOOD_WAIT_SECONDS=60
FLOOD_WAIT_RETRIES=2

LOG_LEVEL=info
