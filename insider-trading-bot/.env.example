# Copy to .env and fill in. .env is gitignored; this file is committed.

# --- credentials (all required) ---

# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# From @BotFather. The bot must be added to the channel as an admin with
# "Post Messages" permission, or sendMessage fails with 403.
TELEGRAM_BOT_TOKEN=""

# Either @publicchannelname or the numeric id (-100...) for a private channel.
TELEGRAM_CHANNEL_ID=""

# https://finnhub.io/dashboard — free tier is 60 req/min, enough for this worker.
FINNHUB_API_KEY=""

# https://www.marketaux.com/ — free tier is 100 req/day; the cycle uses ~8/day at
# the default 3-hour interval, so there is headroom if you add more calls.
MARKETAUX_API_KEY=""

# SEC requires a descriptive User-Agent with real contact info on every EDGAR
# request. Without it you get 403s and eventually an IP block.
# Format: "Company or App Name your@email.com"
SEC_USER_AGENT="insider-bot you@example.com"

# --- models ---

# Stage 1: high-volume headline triage. Cheap nano-tier is the right fit here.
TRIAGE_MODEL="gpt-5.6-luna"
# Stage 2: writes the actual trade thesis. Worth a stronger model — this is where
# the second-order reasoning happens.
THESIS_MODEL="gpt-5.6"

# --- storage ---
# Postgres connection string. Required — there is no default, because a wrong
# guess would be a worker happily writing its call history somewhere nobody reads.
#
# Under docker-compose this is overridden to point at the bundled `db` service,
# so you can leave it as-is for a local run. On gagarin it is not set here at all:
# `gg deps add insider-bot/bot db` injects DB_URL from the postgres resource, and
# an injected variable outranks anything a deploy passes.
DB_URL="postgres://insider:insider@localhost:5433/insider"

# --- tuning ---

# Minimum conviction (1-10) to publish. 7 is the documented publishable floor.
MIN_CONVICTION="7"
# No second post on the same ticker inside this many hours.
TICKER_COOLDOWN_HOURS="72"
# Hard cap on posts in any rolling 24h. Keep this low — a channel posting 20
# ideas a day carries no signal.
MAX_POSTS_PER_DAY="3"
# Events older than this are not triaged at all.
MAX_EVENT_AGE_HOURS="72"

# Whether to ingest Finnhub's general news feed. Off by default: measured
# 2026-08-14, that feed is Reuters *world* news (macro, commodities, geopolitics),
# not company events — it produced 68 of 174 triage rejections and zero passes,
# ~38% of the triage spend for no signal. Finnhub is still always used for quotes
# and fundamentals; this only controls the news feed.
FINNHUB_NEWS_ENABLED="false"

# --- schedules (cron, evaluated in UTC) ---
INGEST_CRON="7 */3 * * *"
SCORE_CRON="0 14 * * 1"

# --- misc ---
LOG_LEVEL="info"
# true = run the full pipeline but log messages instead of sending them.
DRY_RUN="false"

# Skip the thesis stage below this market cap (USD). Mirrors thesis gate 7, but
# enforced in code since it is a hard number we already have from Finnhub before
# the expensive call — three of the first six production theses were sub-$50M
# shells the gate rejected anyway.
MIN_MARKET_CAP_USD="50000000"
