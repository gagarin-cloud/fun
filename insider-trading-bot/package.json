{
  "name": "insider-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src/llm/prompts','dist/llm/prompts',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "ingest:dry": "tsx --env-file-if-exists=.env src/scripts/ingest-dry.ts",
    "triage:dry": "tsx --env-file-if-exists=.env src/scripts/triage-dry.ts",
    "thesis:dry": "tsx --env-file-if-exists=.env src/scripts/thesis-dry.ts",
    "score": "tsx --env-file-if-exists=.env src/scripts/score.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "finnhub": "^2.0.15",
    "grammy": "^1.35.0",
    "node-cron": "^4.6.0",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
